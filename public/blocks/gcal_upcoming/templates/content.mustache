{{!
    @template block_gcal_upcoming/content

    Upcoming events and Google Calendar status.

    Example context (json):
    {
        "events": [{"title": "Essay", "day": "30", "month": "Oct", "time": "10:00", "deadline": true,
            "category": "Assignment deadlines", "color": "#e8590c", "course": "LP02", "url": "#"}],
        "hasevents": true, "days": 14, "calendarurl": "#",
        "status": {"active": true, "email": "learner@example.com", "lastsynctext": "21/10/26, 14:30",
            "canconnect": true, "connected": true, "connecturl": "#"}
    }
}}
<div class="bgu">
    {{#hasevents}}
        <ul class="bgu-list">
            {{#events}}
                <li class="bgu-item">
                    <span class="bgu-date" style="--bgu-color: {{color}}"><strong>{{day}}</strong>{{month}}</span>
                    <span class="bgu-body">
                        {{#url}}<a class="bgu-title" href="{{url}}">{{title}}</a>{{/url}}
                        {{^url}}<span class="bgu-title">{{title}}</span>{{/url}}
                        <span class="bgu-meta">{{time}}{{#deadline}} · {{#str}} deadline, local_gcal {{/str}}{{/deadline}}{{#course}} · {{course}}{{/course}} · {{category}}</span>
                    </span>
                </li>
            {{/events}}
        </ul>
    {{/hasevents}}
    {{^hasevents}}
        <p class="bgu-empty">{{#str}} noupcoming, block_gcal_upcoming, {{days}} {{/str}}</p>
    {{/hasevents}}

    <div class="bgu-footer">
        {{#status.active}}
            <span class="bgu-sync"><span class="bgu-ok" aria-hidden="true"></span>{{#str}} connectedto, local_gcal {{/str}} · {{#str}} lastsync, local_gcal, {{status.lastsynctext}} {{/str}}</span>
        {{/status.active}}
        {{#status.needsreconnect}}
            <a class="btn btn-sm btn-outline-danger" href="{{status.connecturl}}">{{#str}} reconnect, local_gcal {{/str}}</a>
        {{/status.needsreconnect}}
        {{^status.connected}}{{#status.canconnect}}
            <a class="btn btn-sm btn-outline-primary" href="{{status.connecturl}}">{{#str}} connect, local_gcal {{/str}}</a>
        {{/status.canconnect}}{{/status.connected}}
        <a class="btn btn-sm btn-primary" href="{{calendarurl}}">{{#str}} opencalendar, block_gcal_upcoming {{/str}}</a>
    </div>
</div>
