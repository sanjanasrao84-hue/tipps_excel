{{!
    @template local_gcal/event_details

    Details of an event (modal body).

    Example context (json):
    {
        "categoryname": "Assignment deadline", "color": "#e8590c", "when": "Thursday 30 October, 10:00",
        "coursename": "Level 2 Psychiatry", "location": "", "locationurl": false, "description": "Submit your essay.",
        "personal": false, "synced": true, "url": "#", "googleurl": "#", "isactivity": true,
        "canedit": false, "candelete": false, "editdatesurl": "#", "eventid": 12
    }
}}
<div class="lgc-details">
    <span class="lgc-pill" style="--lgc-pill: {{color}}">{{categoryname}}</span>
    <dl class="lgc-details__list">
        <dt>{{#str}} when, local_gcal {{/str}}</dt>
        <dd>{{when}}</dd>
        {{#coursename}}
            <dt>{{#str}} course, local_gcal {{/str}}</dt>
            <dd>{{coursename}}</dd>
        {{/coursename}}
        {{#location}}
            <dt>{{#str}} location, local_gcal {{/str}}</dt>
            <dd>{{#locationurl}}<a href="{{location}}" target="_blank" rel="noopener">{{location}}</a>{{/locationurl}}{{^locationurl}}{{location}}{{/locationurl}}</dd>
        {{/location}}
    </dl>
    {{#description}}<p class="lgc-details__description">{{description}}</p>{{/description}}
    <p class="lgc-details__sync">
        {{#personal}}{{#str}} personalnote, local_gcal {{/str}}{{/personal}}
        {{^personal}}
            {{#synced}}{{#str}} syncedtogoogle, local_gcal {{/str}}{{/synced}}
            {{^synced}}{{#str}} notsynced, local_gcal {{/str}}{{/synced}}
        {{/personal}}
    </p>
    <div class="lgc-details__actions">
        {{#url}}
            <a class="btn btn-primary" href="{{url}}">{{#isactivity}}{{#str}} openactivity, local_gcal {{/str}}{{/isactivity}}{{^isactivity}}{{#str}} opencourse, local_gcal {{/str}}{{/isactivity}}</a>
        {{/url}}
        {{#googleurl}}
            <a class="btn btn-outline-secondary" href="{{googleurl}}" target="_blank" rel="noopener">{{#str}} openingoogle, local_gcal {{/str}}</a>
        {{/googleurl}}
        {{#canedit}}
            <button type="button" class="btn btn-outline-secondary" data-action="edit" data-eventid="{{eventid}}">{{#str}} editevent, local_gcal {{/str}}</button>
        {{/canedit}}
        {{#editdatesurl}}
            <a class="btn btn-outline-secondary" href="{{editdatesurl}}">{{#str}} editdates, local_gcal {{/str}}</a>
        {{/editdatesurl}}
        {{#candelete}}
            <button type="button" class="btn btn-outline-danger" data-action="delete" data-eventid="{{eventid}}">{{#str}} cancelevent, local_gcal {{/str}}</button>
        {{/candelete}}
    </div>
</div>
