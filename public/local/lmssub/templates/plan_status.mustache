{{!
    @template local_lmssub/plan_status

    The learner's subscription to a plan: active, in grace or ended.

    Example context (json):
    {"owned": true, "ingrace": false, "until": "12 November 2026", "expired": false, "expiredon": ""}
}}
{{#owned}}
    {{^ingrace}}
    <div class="lmssub-status lmssub-status-active">
        <i class="fa fa-check-circle" aria-hidden="true"></i>{{#str}}yourplanuntil, local_lmssub, {{until}}{{/str}}
    </div>
    {{/ingrace}}
    {{#ingrace}}
    <div class="lmssub-status lmssub-status-grace">
        <i class="fa fa-clock-o" aria-hidden="true"></i>{{#str}}graceuntil, local_lmssub, {{until}}{{/str}}
    </div>
    {{/ingrace}}
{{/owned}}
{{#expired}}
<div class="lmssub-status lmssub-status-expired">
    <i class="fa fa-history" aria-hidden="true"></i>{{#str}}expiredon, local_lmssub, {{expiredon}}{{/str}}
</div>
{{/expired}}
