{{!
    @template local_lmssub/plan_duration

    One duration choice of a plan card. Disabled choices are not sent with the form.

    Example context (json):
    {
        "id": 5, "duration": "3 months", "amount": "₹1,299.00", "permonth": "₹433.00", "showpermonth": true,
        "saving": 13, "best": true, "checked": true, "disabled": false
    }
}}
<div class="lmssub-duration">
    <input type="radio" class="btn-check" name="priceid" value="{{id}}"
           id="lmssub-price-{{id}}" autocomplete="off" required {{#checked}}checked{{/checked}} {{#disabled}}disabled{{/disabled}}
           data-amount="{{amount}}" data-duration="/ {{duration}}"
           data-permonth="{{#showpermonth}}{{#str}}permonth, local_lmssub, {{permonth}}{{/str}}{{/showpermonth}}">
    <label class="lmssub-duration-label" for="lmssub-price-{{id}}">
        {{#best}}<span class="lmssub-best">{{#str}}bestvalue, local_lmssub{{/str}}</span>{{/best}}
        <span class="lmssub-duration-name">{{duration}}</span>
        <span class="lmssub-duration-amount">{{amount}}</span>
        {{#saving}}<span class="lmssub-saving">{{#str}}save, local_lmssub, {{saving}}{{/str}}</span>{{/saving}}
    </label>
</div>
