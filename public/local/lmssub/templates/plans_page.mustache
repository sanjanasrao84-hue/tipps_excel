{{!
    @template local_lmssub/plans_page

    The learner's subscription plans page.

    Example context (json):
    {
        "intro": "Pick the plan that fits how you learn.",
        "coursename": "",
        "showallurl": "",
        "myurl": "#",
        "dashboardurl": "#",
        "checkouturl": "#",
        "courseid": 0,
        "hasactive": true,
        "active": [{"name": "Psychiatry Beginner", "until": "12 November 2026", "ingrace": false}],
        "hasplans": true,
        "allaccess": {
            "id": 18, "name": "All in one subscription", "typelabel": "Full access (all courses)",
            "owned": false, "ingrace": false, "until": "", "expired": false, "expiredon": "",
            "description": "", "hasdescription": false, "features": ["Opens all 4 courses, plus new ones"],
            "courses": [{"name": "Psychiatry Beginner", "image": ""}], "hasmore": false, "more": [], "morelabel": "",
            "prices": [{"id": 43, "duration": "3 months", "amount": "₹2,199.00", "permonth": "₹733.00", "showpermonth": true,
                "saving": 0, "best": false, "checked": true, "disabled": false}],
            "buttonlabel": "Subscribe now", "buttonlabelaria": "Subscribe to All in one subscription"
        },
        "bundle": {
            "url": "#", "sesskey": "abc", "discount": 10, "hasdiscount": true, "moneysample": "₹12,34,567.89",
            "courses": [
                {"courseid": 2, "name": "Psychiatry Beginner", "image": "", "from": "From ₹1,299.00", "checked": true,
                    "pricesjson": "{\"90\":129900}"},
                {"courseid": 3, "name": "Level 2 Psychiatry", "image": "", "from": "From ₹899.00", "checked": false,
                    "pricesjson": "{\"90\":89900}"}
            ],
            "durations": [{"days": 90, "duration": "3 months"}]
        },
        "single": {
            "headline": {"amount": "₹1,299.00", "duration": "3 months", "permonth": "₹433.00", "showpermonth": true},
            "courses": [{"courseid": 2, "planid": 4, "name": "Psychiatry Beginner", "image": "", "from": "From ₹1,299.00",
                "selected": true, "owned": false, "until": "",
                "prices": [{"id": 6, "duration": "3 months", "amount": "₹1,299.00", "permonth": "₹433.00",
                    "showpermonth": true, "saving": 0, "best": false, "checked": true, "disabled": false}]}]
        }
    }
}}
<div class="lmssub-plans" data-region="lmssub-plans">

    <section class="lmssub-hero mb-4">
        <div class="lmssub-hero-text">
            <span class="lmssub-eyebrow">{{#str}}hero_eyebrow, local_lmssub{{/str}}</span>
            {{#coursename}}
                <h2 class="lmssub-hero-title">{{#str}}plansforcourse, local_lmssub, {{coursename}}{{/str}}</h2>
            {{/coursename}}
            {{^coursename}}
                <h2 class="lmssub-hero-title">{{#str}}hero_title, local_lmssub{{/str}}</h2>
            {{/coursename}}
            <p class="lmssub-hero-intro mb-0">{{intro}}</p>
            {{#showallurl}}
                <a href="{{showallurl}}" class="btn btn-link px-0 mt-2">
                    <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>{{#str}}showallplans, local_lmssub{{/str}}
                </a>
            {{/showallurl}}
        </div>
        <ul class="lmssub-trust list-unstyled mb-0">
            <li><i class="fa fa-bolt" aria-hidden="true"></i><span>{{#str}}trust_instant, local_lmssub{{/str}}</span></li>
            <li><i class="fa fa-lock" aria-hidden="true"></i><span>{{#str}}trust_secure, local_lmssub{{/str}}</span></li>
            <li><i class="fa fa-bookmark" aria-hidden="true"></i><span>{{#str}}trust_progress, local_lmssub{{/str}}</span></li>
        </ul>
    </section>

    {{#hasactive}}
    <section class="lmssub-active mb-4" aria-labelledby="lmssub-active-heading">
        <div class="lmssub-active-icon" aria-hidden="true"><i class="fa fa-check"></i></div>
        <div class="flex-grow-1 min-w-0">
            <h3 id="lmssub-active-heading" class="lmssub-active-title">{{#str}}youractiveplans, local_lmssub{{/str}}</h3>
            <ul class="list-unstyled mb-0 lmssub-active-list">
                {{#active}}
                <li>
                    <strong>{{name}}</strong>
                    <span class="text-body-secondary">&middot; {{#str}}activeuntil, local_lmssub, {{until}}{{/str}}</span>
                    {{#ingrace}}<span class="badge bg-warning text-dark ms-1">{{#str}}status_grace, local_lmssub{{/str}}</span>{{/ingrace}}
                </li>
                {{/active}}
            </ul>
        </div>
        <a href="{{myurl}}" class="btn btn-outline-primary lmssub-btn text-nowrap">{{#str}}managesubscriptions, local_lmssub{{/str}}</a>
    </section>
    {{/hasactive}}

    {{#hasplans}}
    <div class="lmssub-plan-grid mb-5">
        {{#allaccess}}
        <div class="lmssub-plan-cell" data-plantype="allaccess">
            <article class="lmssub-plan {{#owned}}lmssub-plan-owned{{/owned}}" aria-labelledby="lmssub-plan-{{id}}">
                <div class="lmssub-plan-head">
                    <div class="lmssub-badges">
                        <span class="badge lmssub-type lmssub-type-allaccess">{{typelabel}}</span>
                        <span class="badge lmssub-type">{{#str}}everythingincluded, local_lmssub{{/str}}</span>
                    </div>
                    {{> local_lmssub/plan_status }}
                    <h3 id="lmssub-plan-{{id}}" class="lmssub-plan-name">{{name}}</h3>
                    {{#hasdescription}}<div class="lmssub-plan-description">{{{description}}}</div>{{/hasdescription}}
                </div>

                <form method="get" action="{{checkouturl}}" class="lmssub-plan-form" data-region="lmssub-checkout">
                    {{#courseid}}<input type="hidden" name="courseid" value="{{courseid}}">{{/courseid}}

                    <div class="lmssub-price" aria-live="polite">
                        <span class="lmssub-price-amount" data-region="amount">{{#prices}}{{#checked}}{{amount}}{{/checked}}{{/prices}}</span>
                        <span class="lmssub-price-duration" data-region="duration">{{#prices}}{{#checked}}/ {{duration}}{{/checked}}{{/prices}}</span>
                        <div class="lmssub-price-permonth" data-region="permonth">{{#prices}}{{#checked}}{{#showpermonth}}{{#str}}permonth, local_lmssub, {{permonth}}{{/str}}{{/showpermonth}}{{/checked}}{{/prices}}</div>
                    </div>

                    <fieldset class="lmssub-section">
                        <legend class="lmssub-label">{{#str}}chooseduration, local_lmssub{{/str}}</legend>
                        <div class="lmssub-durations">
                            {{#prices}}{{> local_lmssub/plan_duration }}{{/prices}}
                        </div>
                    </fieldset>

                    <ul class="lmssub-features list-unstyled">
                        {{#features}}
                        <li><i class="fa fa-check" aria-hidden="true"></i><span>{{.}}</span></li>
                        {{/features}}
                    </ul>

                    <ul class="lmssub-courses list-unstyled">
                        {{#courses}}
                        <li>
                            <span class="lmssub-thumb" style="background-image: url('{{image}}');" aria-hidden="true"></span>
                            <span class="lmssub-course-name">{{name}}</span>
                        </li>
                        {{/courses}}
                    </ul>
                    {{#hasmore}}
                    <details class="lmssub-more">
                        <summary>{{morelabel}}</summary>
                        <ul class="mb-0 mt-2">
                            {{#more}}<li>{{.}}</li>{{/more}}
                        </ul>
                    </details>
                    {{/hasmore}}

                    <div class="lmssub-actions">
                        <button type="submit" class="btn btn-primary lmssub-btn w-100" aria-label="{{buttonlabelaria}}"
                                data-loading-text="{{#str}}openingcheckout, local_lmssub{{/str}}">
                            <span data-region="label">{{buttonlabel}}</span>
                            <i class="fa fa-arrow-right ms-1" aria-hidden="true" data-region="icon"></i>
                        </button>
                        {{#owned}}
                        <a href="{{myurl}}" class="btn btn-outline-primary lmssub-btn w-100">{{#str}}managesubscription, local_lmssub{{/str}}</a>
                        {{/owned}}
                    </div>
                </form>
            </article>
        </div>
        {{/allaccess}}

        {{#bundle}}
        <div class="lmssub-plan-cell" data-plantype="bundle">
            <article class="lmssub-plan" aria-labelledby="lmssub-plan-bundle">
                <div class="lmssub-plan-head">
                    <div class="lmssub-badges">
                        <span class="badge lmssub-type lmssub-type-bundle">{{#str}}type_bundle, local_lmssub{{/str}}</span>
                        {{#hasdiscount}}<span class="badge lmssub-type">{{#str}}bundle_discountbadge, local_lmssub, {{discount}}{{/str}}</span>{{/hasdiscount}}
                    </div>
                    <h3 id="lmssub-plan-bundle" class="lmssub-plan-name">{{#str}}bundle_title, local_lmssub{{/str}}</h3>
                    <div class="lmssub-plan-description">{{#str}}bundle_intro, local_lmssub{{/str}}</div>
                </div>

                <form method="post" action="{{url}}" class="lmssub-plan-form" data-region="lmssub-checkout" data-lmssub-bundle
                      data-min="2" data-discount="{{discount}}" data-money-sample="{{moneysample}}"
                      data-hint-min="{{#str}}bundle_hintmin, local_lmssub, 2{{/str}}"
                      data-hint-count="{{#str}}bundle_hintcount, local_lmssub, COUNT{{/str}}"
                      data-saving="{{#str}}bundle_saving, local_lmssub, AMOUNT{{/str}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{#courseid}}<input type="hidden" name="courseid" value="{{courseid}}">{{/courseid}}

                    <div class="lmssub-price" aria-live="polite">
                        <span class="lmssub-price-amount" data-region="amount">&ndash;</span>
                        <span class="lmssub-price-duration" data-region="duration"></span>
                        <div class="lmssub-price-permonth" data-region="permonth"></div>
                    </div>

                    <fieldset class="lmssub-section">
                        <legend class="lmssub-label">{{#str}}bundle_choosecourses, local_lmssub{{/str}}</legend>
                        <ul class="lmssub-pick list-unstyled">
                            {{#courses}}
                            <li>
                                <input class="form-check-input" type="checkbox" name="courses[]" value="{{courseid}}"
                                       id="lmssub-bundle-course-{{courseid}}" data-prices="{{pricesjson}}" {{#checked}}checked{{/checked}}>
                                <label class="lmssub-pick-label" for="lmssub-bundle-course-{{courseid}}">
                                    <span class="lmssub-thumb" style="background-image: url('{{image}}');" aria-hidden="true"></span>
                                    <span class="lmssub-course-name">{{name}}</span>
                                    <span class="lmssub-pick-from">{{from}}</span>
                                </label>
                            </li>
                            {{/courses}}
                        </ul>
                        <div class="lmssub-pick-hint" data-region="hint" aria-live="polite">{{#str}}bundle_hintmin, local_lmssub, 2{{/str}}</div>
                    </fieldset>

                    <fieldset class="lmssub-section">
                        <legend class="lmssub-label">{{#str}}chooseduration, local_lmssub{{/str}}</legend>
                        <div class="lmssub-durations">
                            {{#durations}}
                            <div class="lmssub-duration">
                                <input type="radio" class="btn-check" name="days" value="{{days}}" id="lmssub-bundle-days-{{days}}"
                                       autocomplete="off" required disabled data-duration="/ {{duration}}">
                                <label class="lmssub-duration-label" for="lmssub-bundle-days-{{days}}">
                                    <span class="lmssub-duration-name">{{duration}}</span>
                                    <span class="lmssub-duration-amount" data-region="days-amount">&ndash;</span>
                                </label>
                            </div>
                            {{/durations}}
                        </div>
                    </fieldset>

                    <div class="lmssub-actions">
                        <button type="submit" class="btn btn-primary lmssub-btn w-100" disabled
                                data-loading-text="{{#str}}openingcheckout, local_lmssub{{/str}}">
                            <span data-region="label">{{#str}}subscribenow, local_lmssub{{/str}}</span>
                            <i class="fa fa-arrow-right ms-1" aria-hidden="true" data-region="icon"></i>
                        </button>
                    </div>
                </form>
            </article>
        </div>
        {{/bundle}}

        {{#single}}
        <div class="lmssub-plan-cell" data-plantype="course">
            <article class="lmssub-plan" aria-labelledby="lmssub-plan-single">
                <div class="lmssub-plan-head">
                    <div class="lmssub-badges">
                        <span class="badge lmssub-type lmssub-type-course">{{#str}}type_course, local_lmssub{{/str}}</span>
                    </div>
                    <h3 id="lmssub-plan-single" class="lmssub-plan-name">{{#str}}single_title, local_lmssub{{/str}}</h3>
                    <div class="lmssub-plan-description">{{#str}}single_intro, local_lmssub{{/str}}</div>
                </div>

                <form method="get" action="{{checkouturl}}" class="lmssub-plan-form" data-region="lmssub-checkout" data-lmssub-single>
                    {{#courseid}}<input type="hidden" name="courseid" value="{{courseid}}">{{/courseid}}

                    <div class="lmssub-price" aria-live="polite">
                        {{#headline}}
                        <span class="lmssub-price-amount" data-region="amount">{{amount}}</span>
                        <span class="lmssub-price-duration" data-region="duration">/ {{duration}}</span>
                        <div class="lmssub-price-permonth" data-region="permonth">{{#showpermonth}}{{#str}}permonth, local_lmssub, {{permonth}}{{/str}}{{/showpermonth}}</div>
                        {{/headline}}
                    </div>

                    <fieldset class="lmssub-section">
                        <legend class="lmssub-label">{{#str}}single_choosecourse, local_lmssub{{/str}}</legend>
                        <ul class="lmssub-pick list-unstyled">
                            {{#courses}}
                            <li>
                                <input class="form-check-input" type="radio" name="singlecourse" value="{{courseid}}"
                                       id="lmssub-single-course-{{courseid}}" required {{#selected}}checked{{/selected}}>
                                <label class="lmssub-pick-label" for="lmssub-single-course-{{courseid}}">
                                    <span class="lmssub-thumb" style="background-image: url('{{image}}');" aria-hidden="true"></span>
                                    <span class="lmssub-course-name">{{name}}</span>
                                    <span class="lmssub-pick-from">{{from}}</span>
                                    {{#owned}}<span class="lmssub-pick-owned">{{#str}}yourplanuntil, local_lmssub, {{until}}{{/str}}</span>{{/owned}}
                                </label>
                            </li>
                            {{/courses}}
                        </ul>
                    </fieldset>

                    <fieldset class="lmssub-section">
                        <legend class="lmssub-label">{{#str}}chooseduration, local_lmssub{{/str}}</legend>
                        {{#courses}}
                        <div class="lmssub-durations" data-course="{{courseid}}" {{^selected}}hidden{{/selected}}>
                            {{#prices}}{{> local_lmssub/plan_duration }}{{/prices}}
                        </div>
                        {{/courses}}
                    </fieldset>

                    <div class="lmssub-actions">
                        <button type="submit" class="btn btn-primary lmssub-btn w-100"
                                data-loading-text="{{#str}}openingcheckout, local_lmssub{{/str}}">
                            <span data-region="label">{{#str}}subscribenow, local_lmssub{{/str}}</span>
                            <i class="fa fa-arrow-right ms-1" aria-hidden="true" data-region="icon"></i>
                        </button>
                    </div>
                </form>
            </article>
        </div>
        {{/single}}
    </div>
    {{/hasplans}}

    {{^hasplans}}
    <div class="lmssub-empty mb-5">
        <div class="lmssub-empty-icon" aria-hidden="true"><i class="fa fa-calendar-o"></i></div>
        <p class="mb-3">{{#str}}noplansavailable, local_lmssub{{/str}}</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            {{#showallurl}}<a href="{{showallurl}}" class="btn btn-primary lmssub-btn">{{#str}}showallplans, local_lmssub{{/str}}</a>{{/showallurl}}
            {{#hasactive}}<a href="{{myurl}}" class="btn btn-outline-primary lmssub-btn">{{#str}}managesubscriptions, local_lmssub{{/str}}</a>{{/hasactive}}
            <a href="{{dashboardurl}}" class="btn btn-outline-primary lmssub-btn">{{#str}}myhome{{/str}}</a>
        </div>
    </div>
    {{/hasplans}}

    <section class="lmssub-panel lmssub-steps mb-4" aria-labelledby="lmssub-steps-heading">
        <h3 id="lmssub-steps-heading" class="lmssub-panel-title">{{#str}}howitworks, local_lmssub{{/str}}</h3>
        <ol class="lmssub-step-list list-unstyled mb-0">
            <li class="lmssub-step"><span class="lmssub-step-num">1</span><div><strong>{{#str}}step1_title, local_lmssub{{/str}}</strong><p class="mb-0">{{#str}}step1_text, local_lmssub{{/str}}</p></div></li>
            <li class="lmssub-step"><span class="lmssub-step-num">2</span><div><strong>{{#str}}step2_title, local_lmssub{{/str}}</strong><p class="mb-0">{{#str}}step2_text, local_lmssub{{/str}}</p></div></li>
            <li class="lmssub-step"><span class="lmssub-step-num">3</span><div><strong>{{#str}}step3_title, local_lmssub{{/str}}</strong><p class="mb-0">{{#str}}step3_text, local_lmssub{{/str}}</p></div></li>
        </ol>
    </section>

    <section class="lmssub-panel lmssub-faq mb-4" aria-labelledby="lmssub-faq-heading">
        <h3 id="lmssub-faq-heading" class="lmssub-panel-title">{{#str}}faq, local_lmssub{{/str}}</h3>
        <details><summary>{{#str}}faq1_q, local_lmssub{{/str}}</summary><p>{{#str}}faq1_a, local_lmssub{{/str}}</p></details>
        <details><summary>{{#str}}faq2_q, local_lmssub{{/str}}</summary><p>{{#str}}faq2_a, local_lmssub{{/str}}</p></details>
        <details><summary>{{#str}}faq3_q, local_lmssub{{/str}}</summary><p>{{#str}}faq3_a, local_lmssub{{/str}}</p></details>
        <details><summary>{{#str}}faq4_q, local_lmssub{{/str}}</summary><p>{{#str}}faq4_a, local_lmssub{{/str}}</p></details>
        <p class="mt-3 mb-0"><a href="{{myurl}}">{{#str}}mysubscriptions, local_lmssub{{/str}} <i class="fa fa-arrow-right" aria-hidden="true"></i></a></p>
    </section>
</div>
{{#js}}
document.querySelectorAll('[data-region="lmssub-plans"]').forEach(function(root) {
    var showPrice = function(form, amount, duration, permonth) {
        form.querySelector('[data-region="amount"]').textContent = amount;
        form.querySelector('[data-region="duration"]').textContent = duration;
        form.querySelector('[data-region="permonth"]').textContent = permonth;
    };

    // Show the price of the chosen duration in the card's headline.
    root.addEventListener('change', function(e) {
        var input = e.target;
        if (input.name !== 'priceid') {
            return;
        }
        showPrice(input.closest('form'), input.dataset.amount, input.dataset.duration, input.dataset.permonth);
    });

    // Single course: one course at a time. Only the chosen course's durations are shown and sent.
    root.querySelectorAll('[data-lmssub-single]').forEach(function(form) {
        var refresh = function() {
            var chosen = form.querySelector('input[name="singlecourse"]:checked');
            form.querySelectorAll('[data-course]').forEach(function(group) {
                var active = chosen && group.dataset.course === chosen.value;
                group.hidden = !active;
                group.querySelectorAll('input[name="priceid"]').forEach(function(input) {
                    input.disabled = !active;
                });
                if (active) {
                    var price = group.querySelector('input[name="priceid"]:checked') || group.querySelector('input[name="priceid"]');
                    price.checked = true;
                    showPrice(form, price.dataset.amount, price.dataset.duration, price.dataset.permonth);
                }
            });
        };
        form.addEventListener('change', function(e) {
            if (e.target.name === 'singlecourse') {
                refresh();
            }
        });
        refresh();
    });

    // Bundle: at least two courses. The total is the courses' own prices less the bundle discount;
    // the server works it out again before checkout.
    root.querySelectorAll('[data-lmssub-bundle]').forEach(function(form) {
        var min = parseInt(form.dataset.min, 10);
        var discount = parseInt(form.dataset.discount, 10) || 0;
        // Format amounts like the server does, by following its formatted sample of 1234567.89.
        var sample = form.dataset.moneySample;
        var first = sample.search(/\d/);
        var last = sample.length - sample.split('').reverse().join('').search(/\d/);
        var number = sample.slice(first, last);
        var decimal = number.charAt(number.length - 3);
        var groups = number.slice(0, -3).split(/\D/);
        var separator = groups.length > 1 ? number.slice(0, -3).replace(/\d/g, '').charAt(0) : '';
        var primary = groups.length > 1 ? groups[groups.length - 1].length : 0;
        var secondary = groups.length > 2 ? groups[groups.length - 2].length : primary;
        var money = function(paise) {
            var whole = String(Math.floor(paise / 100));
            var parts = [];
            if (primary && whole.length > primary) {
                parts.unshift(whole.slice(-primary));
                whole = whole.slice(0, -primary);
                while (whole.length > secondary) {
                    parts.unshift(whole.slice(-secondary));
                    whole = whole.slice(0, -secondary);
                }
            }
            parts.unshift(whole);
            return sample.slice(0, first) + parts.join(separator) + decimal + String(paise % 100).padStart(2, '0') +
                sample.slice(last);
        };
        var button = form.querySelector('button[type="submit"]');
        var hint = form.querySelector('[data-region="hint"]');

        var refresh = function() {
            var picked = Array.prototype.slice.call(form.querySelectorAll('input[name="courses[]"]:checked'));
            var enough = picked.length >= min;
            hint.textContent = enough ? form.dataset.hintCount.replace('COUNT', picked.length) : form.dataset.hintMin;
            hint.classList.toggle('lmssub-pick-hint-ok', enough);

            // Durations every picked course is sold for, with their totals.
            var totals = {};
            var fulls = {};
            form.querySelectorAll('input[name="days"]').forEach(function(input) {
                var days = input.value;
                var sum = 0;
                var common = picked.length > 0 && picked.every(function(course) {
                    var prices = JSON.parse(course.dataset.prices);
                    if (!(days in prices)) {
                        return false;
                    }
                    sum += prices[days];
                    return true;
                });
                if (common) {
                    fulls[days] = sum;
                    totals[days] = Math.round(sum * (100 - discount) / 100);
                }
                input.disabled = !enough || !common;
                if (input.disabled) {
                    input.checked = false;
                }
                input.nextElementSibling.querySelector('[data-region="days-amount"]').textContent =
                    common && enough ? money(totals[days]) : '–';
            });

            var chosen = form.querySelector('input[name="days"]:checked') || form.querySelector('input[name="days"]:not(:disabled)');
            if (chosen) {
                chosen.checked = true;
                var saving = fulls[chosen.value] - totals[chosen.value];
                showPrice(form, money(totals[chosen.value]), chosen.dataset.duration,
                    saving > 0 ? form.dataset.saving.replace('AMOUNT', money(saving)) : '');
            } else {
                showPrice(form, '–', '', '');
            }
            button.disabled = !enough || !chosen;
        };
        form.addEventListener('change', function(e) {
            if (e.target.name === 'courses[]' || e.target.name === 'days') {
                refresh();
            }
        });
        refresh();
    });

    // While the checkout page opens: show progress and prevent a second submission.
    root.querySelectorAll('[data-region="lmssub-checkout"]').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            var button = form.querySelector('button[type="submit"]');
            if (!button || button.disabled) {
                e.preventDefault();
                return;
            }
            button.dataset.label = button.querySelector('[data-region="label"]').textContent;
            button.querySelector('[data-region="label"]').textContent = button.dataset.loadingText;
            button.querySelector('[data-region="icon"]').className = 'fa fa-spinner fa-spin ms-1';
            button.setAttribute('aria-busy', 'true');
            // Disable after the submission has started, so the button value is still sent.
            setTimeout(function() {
                button.disabled = true;
            }, 0);
        });
    });
    // Coming back with the browser's back button: buttons are usable again.
    window.addEventListener('pageshow', function() {
        root.querySelectorAll('[data-region="lmssub-checkout"] button[type="submit"][aria-busy="true"]').forEach(function(button) {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            button.querySelector('[data-region="label"]').textContent = button.dataset.label;
            button.querySelector('[data-region="icon"]').className = 'fa fa-arrow-right ms-1';
        });
    });
});
{{/js}}
