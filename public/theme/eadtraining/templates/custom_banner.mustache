{{!
    @template theme_eadtraining/custom_banner

    Custom homepage banner.

    Example context (json):
    {
        "title": "Learn at your own pace",
        "subtitle": "Courses for the whole team",
        "description": "<p>Start today.</p>",
        "buttontext": "See courses",
        "buttonurl": "https://example.com/course/",
        "hasbutton": true,
        "textposition": "left",
        "verticalposition": "middle",
        "alignclass": "text-start",
        "hasimage": false,
        "style": "--eadtraining-banner-height: 480px;"
    }
}}
<section class="block_themeeditor eadtraining-custom-banner eadtraining-custom-banner--h-{{textposition}} eadtraining-custom-banner--v-{{verticalposition}}"
         style="{{style}}">
    <div class="eadtraining-custom-banner__overlay"></div>
    <div class="large-container eadtraining-custom-banner__container">
        <div class="eadtraining-custom-banner__content {{alignclass}}">
            {{#title}}
                <h2 class="eadtraining-custom-banner__title">{{{title}}}</h2>
            {{/title}}
            {{#subtitle}}
                <p class="eadtraining-custom-banner__subtitle">{{{subtitle}}}</p>
            {{/subtitle}}
            {{#description}}
                <div class="eadtraining-custom-banner__description">{{{description}}}</div>
            {{/description}}
            {{#hasbutton}}
                <a class="btn btn-primary btn-lg eadtraining-custom-banner__button" href="{{buttonurl}}">{{{buttontext}}}</a>
            {{/hasbutton}}
        </div>
    </div>
</section>
