{{!
    @template theme_eadtraining/glass_dashboard_columns

    Single-series column chart: one teal hue, hover tooltips, and a hidden table for screen readers.

    Example context (json):
    {
        "hasdata": true, "max": 3,
        "days": [{"label": "01 Jan", "short": "Mon", "count": 3, "height": 100, "iszero": false}]
    }
}}
<div class="gd-columns{{^hasdata}} gd-columns--empty{{/hasdata}}" aria-hidden="true">
    <div class="gd-columns__axis"><span class="gd-num">{{#hasdata}}{{max}}{{/hasdata}}{{^hasdata}}1{{/hasdata}}</span><span class="gd-num">0</span></div>
    <div class="gd-columns__plot">
        {{#days}}
            <div class="gd-col{{#iszero}} gd-col--zero{{/iszero}}">
                <span class="gd-col__bar" style="height: {{height}}%"></span>
                <span class="gd-col__tip"><strong class="gd-num">{{count}}</strong> {{label}}</span>
                <span class="gd-col__label">{{short}}</span>
            </div>
        {{/days}}
    </div>
    {{^hasdata}}
        <p class="gd-columns__note">{{#str}}gd_noactivity, theme_eadtraining{{/str}}</p>
    {{/hasdata}}
</div>
<table class="sr-only">
    <tbody>
        {{#days}}<tr><th scope="row">{{label}}</th><td>{{count}}</td></tr>{{/days}}
    </tbody>
</table>
