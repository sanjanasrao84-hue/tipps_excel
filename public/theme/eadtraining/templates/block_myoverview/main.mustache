{{!
    @template theme_eadtraining/block_myoverview/main

    Main content of the course overview block: one toolbar with the filters and the course actions.
    The filter markup and data attributes are the core ones, so block_myoverview/main keeps working.

    Example context (json):
    {}
}}

<div id="block-myoverview-{{uniqid}}" class="block-myoverview block-cards" data-region="myoverview">
    <div class="eadtraining-overview-toolbar">
        <div role="search" data-region="filter" class="eadtraining-overview-filters"
             aria-label="{{#str}} aria:controls, block_myoverview {{/str}}">
            {{> block_myoverview/nav-grouping-selector }}

            {{!
                Override the `searchrole` block with an empty string to remove the `role="search"` landmark in
                `core/search_input_auto` used by the `block_myoverview/nav-search-widget` template.
                It is not necessary for the Course overview block that already has its own search landmark.
            }}
            {{< block_myoverview/nav-search-widget }}
                {{$searchrole}}{{/searchrole}}
            {{/ block_myoverview/nav-search-widget }}

            {{> block_myoverview/nav-sort-selector }}

            {{#displaydropdown}}
                {{> block_myoverview/nav-display-selector }}
            {{/displaydropdown}}
        </div>
        {{#hascourseactions}}
            <div class="eadtraining-overview-actions">
                {{#courseactionurls}}
                    <form action="{{url}}" method="post">
                        <button type="submit" class="{{class}}">{{label}}</button>
                    </form>
                {{/courseactionurls}}
            </div>
        {{/hascourseactions}}
    </div>

    <div class="container-fluid p-0">
        {{> block_myoverview/courses-view }}
    </div>
</div>
{{#js}}
require(
[
    'jquery',
    'block_myoverview/main',
],
function(
    $,
    Main
) {
    var root = $('#block-myoverview-{{uniqid}}');
    Main.init(root);
});
{{/js}}
