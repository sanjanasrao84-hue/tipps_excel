{{!
    @template theme_eadtraining/profile_popup

    Body of the profile popup opened from the navbar avatar.

    Example context (json):
    {
        "picture": "<img src=\"#\" alt=\"\" class=\"userpicture\">",
        "fullname": "Ana Silva",
        "username": "ana",
        "email": "ana@example.com",
        "details": [{"label": "Timezone", "value": "Europe/London"}],
        "hasstatus": false,
        "status": [],
        "returnrole": null,
        "profileurl": "#"
    }
}}
<div class="eadtraining-profile-popup">
    <div class="eadtraining-profile-popup-head">
        <div class="eadtraining-profile-popup-avatar">{{{picture}}}</div>
        <div class="eadtraining-profile-popup-identity">
            <div class="eadtraining-profile-popup-name">{{fullname}}</div>
            <div class="eadtraining-profile-popup-email">{{email}}</div>
        </div>
    </div>

    {{#hasstatus}}
        <div class="eadtraining-profile-popup-status alert alert-info">
            {{#status}}<div>{{{content}}}</div>{{/status}}
            {{#returnrole}}<a href="{{url}}" class="alert-link">{{title}}</a>{{/returnrole}}
        </div>
    {{/hasstatus}}
    {{^hasstatus}}
        {{#returnrole}}
            <div class="eadtraining-profile-popup-status alert alert-info"><a href="{{url}}" class="alert-link">{{title}}</a></div>
        {{/returnrole}}
    {{/hasstatus}}

    <dl class="eadtraining-profile-popup-details">
        {{#username}}
            <div>
                <dt>{{#str}}username{{/str}}</dt>
                <dd>{{username}}</dd>
            </div>
        {{/username}}
        {{#email}}
            <div>
                <dt>{{#str}}email{{/str}}</dt>
                <dd>{{email}}</dd>
            </div>
        {{/email}}
        {{#details}}
            <div>
                <dt>{{label}}</dt>
                <dd>{{{value}}}</dd>
            </div>
        {{/details}}
    </dl>

    <a href="{{profileurl}}" class="eadtraining-profile-popup-profilelink">
        {{#str}}viewprofile{{/str}} <i class="fa fa-arrow-right" aria-hidden="true"></i>
    </a>
</div>
