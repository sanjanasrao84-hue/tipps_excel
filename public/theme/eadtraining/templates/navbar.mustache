{{!

    @template theme_eadtraining/navbar

    This template renders the top navbar.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": false
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": false
            }
        ]
    }
}}
{{!
    Icons-only top bar: no bar, logo or menus (navigation is in the side bar, glass-sidebar below), just the
    notifications, messaging and user menu as a floating group at the top right.
    The menu button stays on screens without the side bar (below lg), and the edit mode switch stays
    because it is the only place to turn editing on.
}}
<nav class="navbar fixed-top navbar-light navbar-expand navbar-icons-only"
     aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler navbar-icons-only__toggler aabtn d-lg-none" data-toggler="drawers"
                data-action="toggle" data-target="theme_eadtraining-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <div id="usernavigation" class="usernavigation navbar-nav ms-auto">
            {{{ output.navbar_plugin_output }}}
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                    {{> core/user_menu }}
                {{/usermenu}}
            </div>
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>

{{> theme_eadtraining/primary-drawer-mobile }}

<aside class="glass-sidebar d-print-none" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <a href="{{{ config.homeurl }}}" class="glass-sidebar__brand aabtn">
        {{# output.should_display_navbar_logo }}
            <img src="{{{output.get_compact_logo_url}}}" class="logo" alt="{{{sitename}}}">
        {{/ output.should_display_navbar_logo }}
        {{^ output.should_display_navbar_logo }}
            <span class="glass-sidebar__mark" aria-hidden="true"><i class="fa fa-graduation-cap"></i></span>
            <span class="glass-sidebar__sitename">{{{sitename}}}</span>
        {{/ output.should_display_navbar_logo }}
    </a>
    <nav class="glass-sidebar__nav">
        {{#mobileprimarynav}}
            {{#haschildren}}
                <details class="glass-sidebar__group" {{#isopen}}open{{/isopen}}>
                    <summary class="glass-sidebar__link" data-key="{{key}}">
                        <span class="glass-sidebar__text">{{{text}}}</span>
                        <i class="fa fa-chevron-down glass-sidebar__chevron" aria-hidden="true"></i>
                    </summary>
                    <div class="glass-sidebar__sub">
                        {{#children}}
                            {{^divider}}
                                <a href="{{{url}}}" class="glass-sidebar__sublink {{#isactive}}active{{/isactive}}"
                                   {{#isactive}}aria-current="page"{{/isactive}}>{{{text}}}</a>
                            {{/divider}}
                        {{/children}}
                    </div>
                </details>
            {{/haschildren}}
            {{^haschildren}}
                <a href="{{{url}}}" class="glass-sidebar__link {{#isactive}}active{{/isactive}}" data-key="{{key}}"
                   {{#isactive}}aria-current="page"{{/isactive}}>
                    <span class="glass-sidebar__text">{{{text}}}</span>
                </a>
            {{/haschildren}}
        {{/mobileprimarynav}}
    </nav>
    {{#usermenu}}
        {{^unauthenticateduser}}
            <a class="glass-sidebar__user" href="{{#profilepopup}}{{profileurl}}{{/profilepopup}}{{^profilepopup}}{{config.wwwroot}}/user/profile.php{{/profilepopup}}">
                {{#avatardata}}<span class="glass-sidebar__avatar {{classes}}">{{{content}}}</span>{{/avatardata}}
                <span class="glass-sidebar__username">{{userfullname}}</span>
            </a>
        {{/unauthenticateduser}}
    {{/usermenu}}
</aside>

<script>
(function () {
    let lastHeight = -1;
    document.addEventListener("scroll", document_scroll_navbar);
    document_scroll_navbar();
    function document_scroll_navbar() {
        if (document.querySelector(".navbar-layout-institutional")) {
            document_scroll_navbar_institutional();
        } else {
            document_scroll_navbar_classic();
        }
    }

    function document_scroll_navbar_institutional() {
        const scrollY = window.scrollY || window.pageYOffset;

        // Troque o seletor se quiser aplicar no .navbar em vez da .navbar-row-top
        const el = document.querySelector(".navbar.fixed-top .navbar-row-top");
        if (!el) return;

        const limit = 180;                 // até onde anima
        const h = el.offsetHeight;         // altura do elemento a “sumir”
        const t = Math.min(Math.max(scrollY / limit, 0), 1); // 0..1

        el.style.marginTop = `${-(h * t)}px`; // 0 -> -h
    }

    function document_scroll_navbar_classic() {
        let scrollY = window.scrollY;
        let limitedScroll = Math.min(scrollY, 180);
        let newHeight = 91 - (limitedScroll / 6);
        newHeight = Math.ceil(Math.max(newHeight, 61));

        if (lastHeight == newHeight) return;
        lastHeight = newHeight;

        const navbar = document.querySelector(".navbar.fixed-top");
        if (navbar) {
            navbar.style.setProperty("--navbar-height", `${newHeight}px`);

            const navbarcontentbackground = document.querySelector(".navbar.fixed-top .navbar-content-background");
            if (navbarcontentbackground) {
                navbarcontentbackground.style.opacity = 1 - (newHeight - 61) / (91 - 61);
            }
        }
    }
})();

// Flexible top bar: it slides away while the user scrolls down and comes back as soon as they scroll up.
// It always shows at the top of the page, while one of its menus is open and while it has keyboard focus.
(function () {
    const navbar = document.querySelector(".navbar.fixed-top");
    if (!navbar) {
        return;
    }
    const TOLERANCE = 8; // px of scroll before it reacts, so small jitters do nothing.
    let lastY = window.scrollY;
    let ticking = false;

    const inUse = () => navbar.contains(document.activeElement) || !!navbar.querySelector(".dropdown-menu.show");

    const update = () => {
        ticking = false;
        const y = Math.max(window.scrollY, 0);
        if (y <= navbar.offsetHeight) {
            navbar.classList.remove("navbar-hidden");
            lastY = y;
            return;
        }
        const delta = y - lastY;
        if (Math.abs(delta) < TOLERANCE) {
            return;
        }
        navbar.classList.toggle("navbar-hidden", delta > 0 && !inUse());
        lastY = y;
    };

    window.addEventListener("scroll", () => {
        if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(update);
        }
    }, {passive: true});
    navbar.addEventListener("focusin", () => navbar.classList.remove("navbar-hidden"));
})();
</script>
