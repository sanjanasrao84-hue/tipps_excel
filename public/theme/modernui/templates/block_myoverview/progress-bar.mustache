{{!
    @template block_myoverview/progress-bar

    Modern UI override: a visible bar plus the "N% complete" text core shows. Used by the Card, List and
    Summary views. The bar is decorative (aria-hidden); the text carries the value for screen readers, as in core.

    Example context (json):
    {
        "progress": 50
    }
}}
<div class="mu-progress">
    <div class="mu-progress-track" aria-hidden="true">
        <div class="mu-progress-fill" style="width: {{progress}}%"></div>
    </div>
    <div class="progress-text mu-progress-text">
        <span class="visually-hidden">{{#str}}aria:courseprogress, block_myoverview{{/str}}</span>
        {{#str}}completepercent, block_myoverview, <span>{{progress}}</span>{{/str}}
    </div>
</div>
