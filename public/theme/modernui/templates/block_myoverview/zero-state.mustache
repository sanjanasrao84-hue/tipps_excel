{{!
    @template block_myoverview/zero-state

    Modern UI override: shown when the user has no courses at all. Same context and buttons as core
    (create / manage courses, or the admin's custom buttons); the core image is replaced by the theme's
    inline illustration so it follows the preset and dark mode.

    Example context (json):
    {
        "nocoursesimg": "https://moodle.org/img/nocourses.svg",
        "title": "No courses",
        "text": "Moodle community",
        "intro": "Come back later",
        "buttons": [
            {"id": "buttons1", "method": "get", "url": "#", "primary": true, "label": "Button1"}
        ]
    }
}}
<div class="block-myoverview block-cards" data-region="myoverview">
    <div class="mu-empty" data-region="empty-message">
        {{> theme_modernui/empty_illustration }}
        <h3 class="mu-empty-title">{{{ title }}}</h3>
        <p class="mu-empty-text">{{{ intro }}}</p>
        <div class="mu-empty-actions" id="action_bar">
            {{#buttons}}
                {{>core/single_button}}
            {{/buttons}}
        </div>
    </div>
</div>
