{{!
    @template core_course/no-courses

    Modern UI override: the "No courses" message (course overview filter with no match, recently accessed
    courses...). Keeps core's {{$nocoursestring}} block so templates that extend this one still set their text.

    Example context (json):
    {
        "nocoursesimg": "https://moodlesite/theme/image.php/boost/block_recentlyaccessedcourses/1535727318/courses",
        "newcourseurl": "https://moodlesite/course/edit.php"
    }
}}
<div class="mu-empty mu-empty-compact" data-region="empty-message">
    {{> theme_modernui/empty_illustration }}
    <p class="mu-empty-text">{{$nocoursestring}}{{#str}} nocourses, core {{/str}}{{/nocoursestring}}</p>
    {{#newcourseurl}}
        <a href="{{{newcourseurl}}}" class="btn btn-primary nocourseslink">{{#str}} createnewcourse, core {{/str}}</a>
    {{/newcourseurl}}
</div>
