{{!
    @template paygw_lmspay/checkout

    The Online payment checkout: one tab per payment method.

    With Razorpay each tab opens Razorpay's own checkout window for that method, except UPI paid straight to the
    account UPI ID (direct), which shows a QR code and asks for the UTR. The model checkout has its own forms.

    Example context (json):
    {
        "brand": "Summit Solutions",
        "description": "Level 2 Psychiatry - 6 months",
        "ordertext": "Order LP-7K2Q9XP4WM",
        "amount": "₹2,899.00",
        "paylabel": "Pay ₹2,899.00",
        "qrcode": "",
        "methods": [{"key": "upi", "label": "UPI", "icon": "fa-solid fa-mobile-screen-button", "first": true}],
        "hasupi": true,
        "upiapps": [{"code": "gpay", "name": "Google Pay", "initials": "GP"}]
    }
}}
<div class="paygw-lmspay">
    <div class="lp-header">
        <div class="min-w-0">
            <div class="lp-brand">{{brand}}</div>
            <div class="small text-truncate">{{description}}</div>
            <div class="small opacity-75">{{ordertext}}</div>
        </div>
        <div class="text-end">
            <div class="small opacity-75">{{#str}}amounttopay, paygw_lmspay{{/str}}</div>
            <div class="lp-amount">{{amount}}</div>
        </div>
    </div>
    {{#ismodel}}
    <div class="alert alert-warning small py-2 my-3">{{#str}}modelnotice, paygw_lmspay{{/str}}</div>
    {{/ismodel}}
    {{^ismodel}}
    <div class="small text-muted my-3"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>{{#str}}securedby, paygw_lmspay{{/str}}</div>
    {{/ismodel}}

    <div class="lp-body">
        <div class="lp-methods nav flex-column nav-pills" role="tablist" aria-label="{{#str}}choosemethod, paygw_lmspay{{/str}}">
            {{#methods}}
            <button type="button" class="nav-link text-start{{#first}} active{{/first}}" role="tab" data-method="{{key}}"
                    aria-selected="{{#first}}true{{/first}}{{^first}}false{{/first}}">
                <i class="{{icon}} fa-fw me-2" aria-hidden="true"></i>{{label}}
            </button>
            {{/methods}}
        </div>

        <div class="lp-panels">
            {{^ismodel}}
            {{#methods}}
            {{#direct}}
            <div class="lp-panel text-center" data-panel="{{key}}" role="tabpanel">
                <div data-region="utrform">
                    <p class="small mb-2">{{#str}}upidirect_intro, paygw_lmspay{{/str}}</p>
                    <div class="lp-qr mx-auto mb-2">
                        <img src="{{qrcode}}" alt="{{#str}}label_qr, paygw_lmspay{{/str}}">
                    </div>
                    <div class="fw-bold mb-1">{{payexact}}</div>
                    <div class="small mb-2">{{#str}}upidirect_payto, paygw_lmspay{{/str}}: <code class="user-select-all">{{upivpa}}</code></div>
                    <a class="btn btn-outline-primary btn-sm mb-3" href="{{upilink}}" data-region="openapp" hidden>
                        <i class="fa-solid fa-mobile-screen-button me-1" aria-hidden="true"></i>{{#str}}upidirect_openapp, paygw_lmspay{{/str}}
                    </a>
                    <div class="text-start">
                        <label class="form-label small fw-bold" for="lp-utr">{{#str}}upidirect_step2, paygw_lmspay{{/str}}</label>
                        <input type="text" class="form-control mb-2" id="lp-utr" inputmode="numeric" autocomplete="off" maxlength="16"
                               placeholder="{{#str}}utrplaceholder, paygw_lmspay{{/str}}">
                        <button type="button" class="btn btn-primary w-100" data-action="utr">{{#str}}utrsubmit, paygw_lmspay{{/str}}</button>
                    </div>
                </div>
                <div class="alert alert-success text-start mb-0" data-region="utrdone" hidden></div>
            </div>
            {{/direct}}
            {{^direct}}
            <div class="lp-panel text-center py-3" data-panel="{{key}}" role="tabpanel">
                <i class="{{icon}} fa-2x text-primary mb-3" aria-hidden="true"></i>
                <p class="mb-4">{{note}}</p>
                <button type="button" class="btn btn-primary w-100" data-action="pay" data-method="{{key}}">{{paylabel}}</button>
            </div>
            {{/direct}}
            {{/methods}}
            {{/ismodel}}

            {{#ismodel}}
            {{#hasupi}}
            <div class="lp-panel" data-panel="upi" role="tabpanel">
                <div class="fw-bold mb-2">{{#str}}upiapps, paygw_lmspay{{/str}}</div>
                <div class="lp-grid mb-3">
                    {{#upiapps}}
                    <button type="button" class="btn btn-outline-secondary lp-tile" data-action="pay" data-method="upi" data-value="{{code}}">
                        <span class="lp-logo" aria-hidden="true">{{initials}}</span>{{name}}
                    </button>
                    {{/upiapps}}
                </div>
                <label class="form-label fw-bold" for="lp-vpa">{{#str}}upiid, paygw_lmspay{{/str}}</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="lp-vpa" autocomplete="off" spellcheck="false"
                           placeholder="{{#str}}upiidplaceholder, paygw_lmspay{{/str}}">
                    <button type="button" class="btn btn-primary" data-action="vpa">{{#str}}verifypay, paygw_lmspay{{/str}}</button>
                </div>
                <div class="lp-waiting alert alert-info small mt-2 mb-0" hidden>
                    <div class="mb-2" data-region="waitingtext"></div>
                    <button type="button" class="btn btn-sm btn-success" data-action="pay" data-method="upi" data-source="vpa">
                        {{#str}}approve, paygw_lmspay{{/str}}
                    </button>
                </div>
            </div>
            {{/hasupi}}

            {{#hasqr}}
            <div class="lp-panel text-center" data-panel="qr" role="tabpanel">
                <p class="small mb-2">{{#str}}qrscan, paygw_lmspay{{/str}}</p>
                <div class="lp-qr mx-auto mb-2">
                    <img src="{{qrcode}}" alt="{{#str}}label_qr, paygw_lmspay{{/str}}">
                    <div class="lp-qr-loading text-center py-5" hidden><span class="spinner-border text-primary" role="status"></span></div>
                    <div class="lp-qr-expired" hidden>
                        <p class="mb-2">{{#str}}qrexpired, paygw_lmspay{{/str}}</p>
                        <button type="button" class="btn btn-sm btn-primary" data-action="qrrefresh">{{#str}}qrrefresh, paygw_lmspay{{/str}}</button>
                    </div>
                </div>
                <div class="small fw-bold mb-3" data-region="qrtimer"></div>
                <button type="button" class="btn btn-success" data-action="pay" data-method="qr">{{#str}}qrpaid, paygw_lmspay{{/str}}</button>
            </div>
            {{/hasqr}}

            {{#hascard}}
            <div class="lp-panel" data-panel="card" role="tabpanel">
                <div class="mb-2">
                    <label class="form-label small mb-1" for="lp-cardnumber">{{#str}}cardnumber, paygw_lmspay{{/str}}</label>
                    <div class="position-relative">
                        <input type="text" class="form-control" id="lp-cardnumber" inputmode="numeric" autocomplete="cc-number"
                               maxlength="23" placeholder="1234 5678 9012 3456">
                        <span class="lp-network badge bg-secondary" data-region="network"></span>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small mb-1" for="lp-cardexpiry">{{#str}}cardexpiry, paygw_lmspay{{/str}}</label>
                        <input type="text" class="form-control" id="lp-cardexpiry" inputmode="numeric" autocomplete="cc-exp"
                               maxlength="5" placeholder="MM/YY">
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1" for="lp-cardcvv">{{#str}}cardcvv, paygw_lmspay{{/str}}</label>
                        <input type="password" class="form-control" id="lp-cardcvv" inputmode="numeric" autocomplete="cc-csc"
                               maxlength="4" placeholder="•••">
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1" for="lp-cardname">{{#str}}cardname, paygw_lmspay{{/str}}</label>
                    <input type="text" class="form-control" id="lp-cardname" autocomplete="cc-name">
                </div>
                <div class="small text-muted mb-3"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>{{#str}}cardsecure, paygw_lmspay{{/str}}</div>
                <button type="button" class="btn btn-primary w-100" data-action="pay" data-method="card">{{paylabel}}</button>
            </div>
            {{/hascard}}

            {{#hasnetbanking}}
            <div class="lp-panel" data-panel="netbanking" role="tabpanel">
                <div class="fw-bold mb-2">{{#str}}choosebank, paygw_lmspay{{/str}}</div>
                <div class="lp-grid mb-2">
                    {{#popularbanks}}
                    <label class="lp-choice">
                        <input type="radio" class="visually-hidden" name="lp-netbanking" value="{{code}}">
                        <span class="lp-logo" aria-hidden="true">{{initials}}</span><span>{{name}}</span>
                    </label>
                    {{/popularbanks}}
                </div>
                <select class="form-select mb-3" data-region="otherbank" aria-label="{{#str}}otherbanks, paygw_lmspay{{/str}}">
                    <option value="">{{#str}}otherbanks, paygw_lmspay{{/str}}</option>
                    {{#otherbanks}}<option value="{{code}}">{{name}}</option>{{/otherbanks}}
                </select>
                <button type="button" class="btn btn-primary w-100" data-action="pay" data-method="netbanking">{{paylabel}}</button>
            </div>
            {{/hasnetbanking}}

            {{#haswallet}}
            <div class="lp-panel" data-panel="wallet" role="tabpanel">
                <div class="fw-bold mb-2">{{#str}}choosewallet, paygw_lmspay{{/str}}</div>
                <div class="lp-list mb-3">
                    {{#wallets}}
                    <label class="lp-choice">
                        <input type="radio" class="visually-hidden" name="lp-wallet" value="{{code}}">
                        <span class="lp-logo" aria-hidden="true">{{initials}}</span><span>{{name}}</span>
                    </label>
                    {{/wallets}}
                </div>
                <button type="button" class="btn btn-primary w-100" data-action="pay" data-method="wallet">{{paylabel}}</button>
            </div>
            {{/haswallet}}

            {{#hasemi}}
            <div class="lp-panel" data-panel="emi" role="tabpanel">
                <label class="form-label fw-bold" for="lp-emibank">{{#str}}emibank, paygw_lmspay{{/str}}</label>
                <select class="form-select mb-3" id="lp-emibank">
                    {{#emibanks}}<option value="{{code}}">{{name}}</option>{{/emibanks}}
                </select>
                <div class="fw-bold mb-2">{{#str}}chooseplan, paygw_lmspay{{/str}}</div>
                <div class="lp-list mb-3">
                    {{#emiplans}}
                    <label class="lp-choice justify-content-between">
                        <input type="radio" class="visually-hidden" name="lp-emi" value="{{months}}">
                        <span>{{label}}</span>
                        <span class="small text-muted text-end">
                            {{#nocost}}<span class="badge bg-success">{{#str}}eminocost, paygw_lmspay{{/str}}</span>{{/nocost}}
                            {{^nocost}}{{ratelabel}}{{/nocost}}
                            <br>{{totallabel}}
                        </span>
                    </label>
                    {{/emiplans}}
                </div>
                <button type="button" class="btn btn-primary w-100" data-action="pay" data-method="emi">{{paylabel}}</button>
            </div>
            {{/hasemi}}
            {{/ismodel}}

            <div class="alert alert-danger small py-2 mt-3 mb-0" data-region="error" hidden></div>
            <div class="lp-processing text-center py-5" hidden>
                <span class="spinner-border text-primary" role="status" aria-hidden="true"></span>
                <div class="mt-2">{{#str}}processing, paygw_lmspay{{/str}}</div>
            </div>
        </div>
    </div>
</div>
