<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/razorpay/db" VERSION="20241116" COMMENT="XMLDB file for razorpay payment gateway plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="paygw_razorpay" COMMENT="Stores razorpay related information">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="rp_orderid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The Razorpay Order Id"/>
        <FIELD NAME="rp_paymentid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Payment Id from razorpay"/>
        <FIELD NAME="rp_signature" TYPE="char" LENGTH="555" NOTNULL="true" SEQUENCE="false" COMMENT="Signature from Razorpay"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="paymentid" TYPE="foreign-unique" FIELDS="paymentid" REFTABLE="payments" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="rp_paymentid" UNIQUE="true" FIELDS="rp_paymentid" COMMENT="A Razorpay payment can be accepted only once"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="paygw_razorpay_order" COMMENT="Every order created on Razorpay, saved on the server so the payment can be checked against it">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The user the order was created for"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Amount in the smallest currency unit (paise)"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="rp_orderid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The Razorpay Order Id"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="created" SEQUENCE="false" COMMENT="created or paid"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The core payment record once paid"/>
        <FIELD NAME="method" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="How it was paid: upi, card, netbanking, wallet, emi, cardless_emi or paylater"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="rp_orderid" UNIQUE="true" FIELDS="rp_orderid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="paygw_razorpay_expiry" COMMENT="Expiry notifications already sent, so each one is sent only once">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userenrolmentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The user enrolment the notification is about"/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Enrolment end time at the moment of sending, so a renewal resets the notifications"/>
        <FIELD NAME="stage" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Days-before threshold, or 'expired'"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ue_timeend_stage" UNIQUE="true" FIELDS="userenrolmentid, timeend, stage"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="paygw_razorpay_upi" COMMENT="Payments made by UPI straight to the site&apos;s own UPI ID, approved by an admin">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The learner paying"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Amount in paise"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reference" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Shown in the UPI payment note, to match the bank statement"/>
        <FIELD NAME="vpa" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="The UPI ID the learner was asked to pay"/>
        <FIELD NAME="utr" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false" COMMENT="UTR / transaction number entered by the learner"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="new" SEQUENCE="false" COMMENT="new, pending, approved or rejected"/>
        <FIELD NAME="note" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Reason given when rejected"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The core payment record once approved"/>
        <FIELD NAME="reviewedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timereviewed" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="reference" UNIQUE="true" FIELDS="reference"/>
        <INDEX NAME="utr" UNIQUE="false" FIELDS="utr"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
